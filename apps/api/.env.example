# Copy to .env.development and fill in real values.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<ref>.supabase.co:5432/postgres?sslmode=require"
PORT=3000
JWT_SECRET="change-me"
JWT_EXPIRES_IN="1d"

# Supabase Storage (S3) — Project Settings → Storage → S3 Connection
S3_ENDPOINT="https://<ref>.supabase.co/storage/v1/s3"
S3_REGION="ap-south-1"
S3_ACCESS_KEY_ID="<access-key>"
S3_SECRET_ACCESS_KEY="<secret-key>"
S3_BUCKET="kyc-documents"
